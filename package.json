{
  "name": "@taxui/taxui",
  "version": "1.0.0",
  "description": "Modern, ultra-fast declarative HTML & CSS framework with zero JS dependencies",
  "main": "dist/taxui.min.css",
  "style": "dist/taxui.min.css",
  "unpkg": "dist/taxui.min.css",
  "jsdelivr": "dist/taxui.min.css",
  "exports": {
    ".": "./dist/taxui.min.css",
    "./base": "./dist/taxui-base.min.css",
    "./layout": "./dist/taxui-layout.min.css",
    "./components": "./dist/taxui-components.min.css",
    "./utilities": "./dist/taxui-utilities.min.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "build:modules": "node scripts/build.js --modules",
    "watch": "node scripts/build.js --watch",
    "test": "node scripts/build.js --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TaxUI/taxui.git"
  },
  "keywords": [
    "css",
    "framework",
    "declarative",
    "html",
    "zero-js",
    "design-system",
    "responsive",
    "dark-mode",
    "flexbox",
    "grid",
    "ui-kit"
  ],
  "author": "TaxUI (https://github.com/TaxUI)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TaxUI/taxui/issues"
  },
  "homepage": "https://taxui.github.io/taxui-docs/"
}
